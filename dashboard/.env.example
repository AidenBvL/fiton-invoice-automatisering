# FitOn boekrapporten — instellingen
#
# Kopieer dit bestand naar .env en pas het aan:
#     cp .env.example .env
#
# Echte omgevingsvariabelen gaan voor op wat hier staat, dus
# `FITON_PORT=9000 node server.js` werkt nog steeds voor een snelle test.
#
# Bewaar .env niet in git en deel hem niet mee met de extensie: het token
# hierin geeft toegang tot het posten van rapporten.


# Gedeeld geheim. Moet gelijk zijn aan wat in de instellingen van de extensie
# staat. Laat dit niet leeg: zonder token mag iedereen die bij de server kan
# rapporten posten.
#
# Iets genereren dat niemand raadt:
#     node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
FITON_TOKEN=


# Poort waarop het dashboard draait.
FITON_PORT=8099


# Op welk adres geluisterd wordt.
#   0.0.0.0   = bereikbaar voor collega's op het netwerk
#   127.0.0.1 = alleen op deze machine (handig om eerst te proberen)
FITON_HOST=127.0.0.1


# De factuur-PDF meesturen en bewaren in documents/.
#   0 = alleen de gegevens van de boeking (standaard)
#   1 = ook de factuur zelf
#
# Let op: met 1 komen facturen op een tweede plek te staan, naast waar ze nu al
# bewaard worden. Bewaartermijn, back-up en wie erbij mag zijn dan vragen voor
# degene die over documentbeheer gaat. Dit moet ook aangevinkt staan in de
# instellingen van de extensie, anders stuurt die niets mee.
FITON_STORE_DOCUMENTS=0


# Waar fiton-runs.db en documents/ komen te staan.
# Leeg laten = naast server.js. Zet dit op een pad dat in de back-up zit.
#FITON_DATA=/var/lib/fiton-rapporten
